<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_card"
    android:animateLayoutChanges="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Term"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDefinition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Definition"
                android:textColor="#CCCCCC"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="21dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/hear"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/baseline_hearing_24" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivExpandToggle"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:contentDescription="Toggle"
            android:src="@drawable/ic_expand_more"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Phần ẩn: phonetic + example -->
    <LinearLayout
        android:id="@+id/expandableLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/tvPhonetic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phonetic"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Example sentence..."
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:paddingTop="4dp"/>
    </LinearLayout>
</LinearLayout>
